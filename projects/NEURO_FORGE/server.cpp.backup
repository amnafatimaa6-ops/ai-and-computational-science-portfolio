#include "NeuralNetwork.hpp"
#include "Dataset.hpp"
#include "Matrix.hpp"

#include <algorithm>
#include <cmath>
#include <iomanip>
#include <iostream>
#include <limits>
#include <stdexcept>
#include <string>
#include <vector>

int main(int argc, char* argv[])
{
    // Usage:
    // neuroforge_bridge.exe value1 value2 ... value9

    if (argc != 10)
    {
        std::cerr
            << "Usage: neuroforge_bridge.exe "
            << "pl_orbper pl_orbsmax pl_orbeccen pl_eqt "
            << "pl_rade st_teff st_mass st_rad st_met\n";

        return 1;
    }

    const std::string modelPath = "data/neuroforge.model";
    const std::string datasetPath = "data/exoplanets_clean.csv";

    const std::vector<std::string> featureNames = {
        "pl_orbper",
        "pl_orbsmax",
        "pl_orbeccen",
        "pl_eqt",
        "pl_rade",
        "st_teff",
        "st_mass",
        "st_rad",
        "st_met"
    };

    try
    {
        // STEP 1: Read the nine raw measurements.
        std::vector<double> rawInputs(9);

        for (int i = 0; i < 9; ++i)
        {
            std::size_t parsed = 0;

            rawInputs[i] = std::stod(argv[i + 1], &parsed);

            if (
                parsed != std::string(argv[i + 1]).size() ||
                !std::isfinite(rawInputs[i])
            )
            {
                throw std::invalid_argument(
                    "Every feature must be a finite number."
                );
            }
        }

        // STEP 2: Load the reference dataset used for scaling.
        Dataset referenceData;

        if (!referenceData.loadCSV(datasetPath, 9))
        {
            throw std::runtime_error(
                "Could not load data/exoplanets_clean.csv. "
                "Run the training program first."
            );
        }

        if (
            referenceData.size() == 0 ||
            referenceData.featureCount() != 9
        )
        {
            throw std::runtime_error(
                "Reference dataset must contain nine features."
            );
        }

        // STEP 3: Reproduce the original min-max normalization.
        std::vector<double> minimum(9,
            std::numeric_limits<double>::max());

        std::vector<double> maximum(9,
            std::numeric_limits<double>::lowest());

        for (const auto& sample : referenceData.samples())
        {
            for (std::size_t j = 0; j < 9; ++j)
            {
                minimum[j] = std::min(
                    minimum[j], sample.features[j]);

                maximum[j] = std::max(
                    maximum[j], sample.features[j]);
            }
        }

        Matrix input(9, 1);
        std::vector<double> normalizedInputs(9);

        for (std::size_t j = 0; j < 9; ++j)
        {
            const double range = maximum[j] - minimum[j];

            normalizedInputs[j] =
                (range > 0.0)
                    ? (rawInputs[j] - minimum[j]) / range
                    : 0.0;

            input(j, 0) = normalizedInputs[j];
        }

        // STEP 4: Load the real trained neural network.
        NeuralNetwork network(9, 8, 0.01);

        if (!network.loadModel(modelPath))
        {
            throw std::runtime_error(
                "Could not load data/neuroforge.model. "
                "Train the network first."
            );
        }

        // STEP 5: Run the actual C++ forward pass.
        const PredictionTrace trace =
            network.predictWithTrace(input);

        const int predictedClass =
            trace.prediction >= 0.5 ? 1 : 0;

        // STEP 6: Return structured JSON for the dashboard.
        std::cout << std::setprecision(12);

        std::cout << "{\n";

        std::cout << "  \"status\": \"ok\",\n";

        std::cout << "  \"feature_names\": [";
        for (std::size_t i = 0; i < featureNames.size(); ++i)
        {
            if (i > 0) std::cout << ", ";
            std::cout << "\"" << featureNames[i] << "\"";
        }
        std::cout << "],\n";

        std::cout << "  \"raw_inputs\": [";
        for (std::size_t i = 0; i < rawInputs.size(); ++i)
        {
            if (i > 0) std::cout << ", ";
            std::cout << rawInputs[i];
        }
        std::cout << "],\n";

        std::cout << "  \"normalized_inputs\": [";
        for (std::size_t i = 0; i < normalizedInputs.size(); ++i)
        {
            if (i > 0) std::cout << ", ";
            std::cout << normalizedInputs[i];
        }
        std::cout << "],\n";

        std::cout << "  \"input_hidden_weights\": [\n";

        for (std::size_t i = 0;
             i < trace.inputHiddenWeights.size(); ++i)
        {
            std::cout << "    [";

            for (std::size_t j = 0;
                 j < trace.inputHiddenWeights[i].size(); ++j)
            {
                if (j > 0) std::cout << ", ";
                std::cout << trace.inputHiddenWeights[i][j];
            }

            std::cout << "]";

            if (i + 1 < trace.inputHiddenWeights.size())
                std::cout << ",";

            std::cout << "\n";
        }

        std::cout << "  ],\n";

        std::cout << "  \"hidden_biases\": [";
        for (std::size_t i = 0; i < trace.hiddenBiases.size(); ++i)
        {
            if (i > 0) std::cout << ", ";
            std::cout << trace.hiddenBiases[i];
        }
        std::cout << "],\n";

        std::cout << "  \"hidden_weighted_sums\": [";
        for (std::size_t i = 0;
             i < trace.hiddenWeightedSums.size(); ++i)
        {
            if (i > 0) std::cout << ", ";
            std::cout << trace.hiddenWeightedSums[i];
        }
        std::cout << "],\n";

        std::cout << "  \"hidden_activations\": [";
        for (std::size_t i = 0;
             i < trace.hiddenActivations.size(); ++i)
        {
            if (i > 0) std::cout << ", ";
            std::cout << trace.hiddenActivations[i];
        }
        std::cout << "],\n";

        std::cout << "  \"hidden_output_weights\": [";
        for (std::size_t i = 0;
             i < trace.hiddenOutputWeights.size(); ++i)
        {
            if (i > 0) std::cout << ", ";
            std::cout << trace.hiddenOutputWeights[i];
        }
        std::cout << "],\n";

        std::cout << "  \"output_bias\": "
                  << trace.outputBias << ",\n";

        std::cout << "  \"output_weighted_sum\": "
                  << trace.outputWeightedSum << ",\n";

        std::cout << "  \"prediction_score\": "
                  << trace.prediction << ",\n";

        std::cout << "  \"predicted_class\": "
                  << predictedClass << ",\n";

        std::cout << "  \"predicted_label\": \""
                  << (predictedClass == 1
                          ? "Transit-method class"
                          : "Non-Transit-method class")
                  << "\"\n";

        std::cout << "}\n";

        return 0;
    }
    catch (const std::exception& error)
    {
        std::cerr << "NeuroForge bridge error: "
                  << error.what() << '\n';

        return 1;
    }
}